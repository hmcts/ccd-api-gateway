{
  "name": "ccd-api-gateway-web",
  "version": "1.4.0",
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "start": "cross-env NODE_PATH=. yarn node server.js",
    "setup": "cross-env NODE_PATH=. yarn node --version",
    "lint": "NODE_PATH=. eslint --ignore-pattern coverage .",
    "test": "yarn test:unit",
    "test:unit": "NODE_ENV=test NODE_PATH=. mocha 'test/**/*.spec.js' --reporter mochawesome --reporter-options reportFilename=unit,inlineAssets=true,reportTitle=ccd-api-gateway --recursive",
    "test:specific": "NODE_ENV=test LOG_LEVEL=DEBUG NODE_PATH=. mocha --recursive ",
    "test:coverage": "NODE_ENV=test NODE_PATH=. nyc mocha 'test/**/*.spec.js' --recursive",
    "fortifyScan": "./test/java/gradlew -p test/java fortifyScan",
    "test:smoke": "PLAYWRIGHT_OUTPUT_DIR=smoke-output playwright test --grep @smoke",
    "test:functional": "PLAYWRIGHT_OUTPUT_DIR=functional-output playwright test --grep @functional --pass-with-no-tests",
    "test:a11y": "NODE_PATH=.",
    "suppress-cve": "yarn npm audit --recursive --environment production --json > yarn-audit-known-issues",
    "sonar-scan": "NODE_PATH=. sonar-scanner -X",
    "test:deployed": "PLAYWRIGHT_OUTPUT_DIR=functional-output playwright test"
  },
  "dependencies": {
    "@hmcts/nodejs-healthcheck": "^1.8.6",
    "@hmcts/nodejs-logging": "^4.0.4",
    "@hmcts/properties-volume": "^1.4.1",
    "applicationinsights": "3.17.0",
    "body-parser": "^2.4.0",
    "brace-expansion": "^5.0.12",
    "config": "^4.4.2",
    "cookie": "^2.0.1",
    "cookie-parser": "~1.4.7",
    "cross-env": "^10.1.0",
    "debug": "~4.4.3",
    "dont-sniff-mimetype": "^1.1.0",
    "express": "^5.3.0",
    "form-data": "^4.0.6",
    "formidable": "^3.5.4",
    "globals": "^17.13.0",
    "handlebars": "^4.7.10",
    "http-proxy-middleware": "^3.0.10",
    "https-proxy-agent": "^9.1.0",
    "js-yaml": "^5.5.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "mem": "^10.0.0",
    "nocache": "^4.0.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "nyc": "^18.0.0",
    "or": "^0.2.0",
    "otp": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@hmcts/playwright-common": "1.1.7",
    "@playwright/test": "^1.64.1",
    "chai": "^6.3.0",
    "chai-http": "^5.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-mocha": "^12.0.2",
    "fetch-mock": "^12.6.0",
    "git-message": "^2.0.2",
    "istanbul": "^0.4.5",
    "jsonwebtoken": "^9.0.3",
    "mocha": "^12.0.3",
    "mochawesome": "^8.1.1",
    "moment": "^2.31.0",
    "nock": "^14.0.17",
    "pa11y": "^9.1.1",
    "playwright-core": "^1.64.1",
    "proxyquire": "^2.1.3",
    "should": "^13.2.3",
    "should-http": "^0.1.1",
    "sinon": "21.1.2",
    "sinon-chai": "^4.0.1",
    "sinon-express-mock": "^2.2.1",
    "sonar-scanner": "^3.1.0",
    "supertest": "^7.3.1"
  },
  "nyc": {
    "extension": [
      ".js"
    ],
    "include": [
      "app"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ],
    "report-dir": "coverage",
    "all": true
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@opentelemetry/core": "^2.8.0",
    "form-data": "^4.0.4",
    "js-yaml": "5.5.0",
    "lodash": "^4.18.1",
    "handlebars": "^4.7.10",
    "memoize": "^10.0.0",
    "minimist": "^1.2.6",
    "ini": "^7.0.0",
    "glob-parent": "^6.0.0",
    "ws": "^6.2.2",
    "ansi-regex": "^5.0.1",
    "follow-redirects": "^1.15.6",
    "moment": "^2.29.4",
    "async": "^3.0.0",
    "json5": "^2.2.2",
    "cookiejar": "^2.1.4",
    "qs": "^6.16.0",
    "@babel/traverse": "8.0.7",
    "@babel/core": "^8.0.0",
    "micromatch": "^4.0.8",
    "cross-spawn": "^7.0.6",
    "braces": "^3.0.3",
    "brace-expansion": "^5.0.9",
    "path-to-regexp@npm:^8.0.0": "npm:path-to-regexp@8.4.2",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "picomatch": "2.3.2",
    "protobufjs": "^7.6.1",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.28.7"
  },
  "overrides": {
    "picomatch": "2.3.2",
    "protobufjs": "^7.6.1"
  }
}
